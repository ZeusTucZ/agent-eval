# Copy to .env and fill in your own values. Never commit a real .env:
# it is in .gitignore, and the keys below only ever live in your local
# .env and in Render's Environment Variables.
#
# DATABASE_PATH: where the SQLite file lives. Local default is evalkit.db;
# on Render it must be /data/agent-eval.db (the persistent disk).
DATABASE_PATH=evalkit.db
# API_TOKEN: shared secret for POST /api/runs and POST .../rescore
# (header X-API-Token). Generate one with: openssl rand -hex 32
API_TOKEN=
# GROQ_API_KEY: console.groq.com (free tier). GEMINI_API_KEY: aistudio.google.com.
GROQ_API_KEY=
GEMINI_API_KEY=
# CORS_ORIGINS: comma-separated origins allowed to call the API from a
# browser. Local Vite dev server first; add the dashboard URL when it exists.
CORS_ORIGINS=http://localhost:5173
# PORT: local default 8000; Render injects its own PORT.
PORT=8000

# REQUESTS_PER_CLIENT_PER_MINUTE: how many requests one client (IP) may make per
# minute before getting 429. Default 120; 0 turns the limit off.
REQUESTS_PER_CLIENT_PER_MINUTE=120
